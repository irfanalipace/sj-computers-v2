{
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "dev": "vite",
        "copy-html": "shx cp dist/index.html resources/views/index.blade.php",
        "copy-assets": "copyfiles -u 1 dist/assets/* public/",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "start": "webpack-dev-server --config webpack.config.dev",
        "build": "vite build && pnpm run copy-html && pnpm run copy-assets",
        "preview": "vite preview"
    },
    "dependencies": {
        "@babel/core": "^7.22.5",
        "@babel/preset-react": "^7.22.5",
